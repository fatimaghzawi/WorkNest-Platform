# WorkNest Client — environment template
# Copy to `.env` (or `.env.development` / `.env.production`).
# Never commit real OAuth client IDs.

# Leave empty in local development — Vite proxies /api, /uploads, /socket.io
# to the backend (see vite.config.ts). Required in production builds.
VITE_API_URL=

# Google Identity Services client ID (OAuth consent screen → Web client)
VITE_GOOGLE_CLIENT_ID=

# GitHub OAuth App client ID
VITE_GITHUB_CLIENT_ID=
